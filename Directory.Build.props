<Project>
  <PropertyGroup>
    <Version>0.0.1</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- Optional machine-specific overrides (gitignored). Drop a GameDir here if auto-detect misses. -->
  <Import Project="$(RepoRoot)Directory.Build.local.props" Condition="Exists('$(RepoRoot)Directory.Build.local.props')" />

  <!--
    Resolve the game install without committing a machine-specific path. Precedence:
      1. -p:GameDir=... on the CLI, or GameDir in Directory.Build.local.props (imported above)
      2. the WORDPLAY_DIR environment variable
      3. Steam's main library, located via the registry (Windows)
      4. the default install location
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(WORDPLAY_DIR)' != ''">$(WORDPLAY_DIR)</GameDir>

    <_SteamPath Condition="'$(GameDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', null, RegistryView.Registry64, RegistryView.Registry32))</_SteamPath>
    <_SteamPath Condition="'$(GameDir)' == '' and '$(_SteamPath)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Valve\Steam', 'InstallPath', null, RegistryView.Registry32, RegistryView.Registry64))</_SteamPath>
    <_SteamGameDir Condition="'$(_SteamPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SteamPath)', 'steamapps', 'common', 'Word Play'))))</_SteamGameDir>
    <GameDir Condition="'$(GameDir)' == '' and '$(_SteamGameDir)' != '' and Exists('$(_SteamGameDir)')">$(_SteamGameDir)</GameDir>

    <GameDir Condition="'$(GameDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\Word Play')">C:\Program Files (x86)\Steam\steamapps\common\Word Play</GameDir>

    <ManagedDir>$(GameDir)\Word Play_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginDeployDir>$(BepInExDir)\plugins\Earplay</PluginDeployDir>
  </PropertyGroup>

  <!-- Only the engine-coupled projects need the game; warn there if detection failed or BepInEx is missing. -->
  <Target Name="_CheckGameDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="('$(MSBuildProjectName)' == 'Earplay' or '$(MSBuildProjectName)' == 'Earplay.Module') and ('$(GameDir)' == '' or !Exists('$(BepInExDir)\core\BepInEx.dll'))">
    <Warning Text="Game or BepInEx not found. GameDir='$(GameDir)'. Set WORDPLAY_DIR, pass -p:GameDir=..., or create Directory.Build.local.props; and run setup-bepinex.ps1 once." />
  </Target>

  <!-- The engine-coupled projects compile against the game's own Mono assemblies and BepInEx 5. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Earplay' or '$(MSBuildProjectName)' == 'Earplay.Module'">
    <Reference Include="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
</Project>
